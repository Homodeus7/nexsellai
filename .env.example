PORT=3001
DATABASE_URL="file:./dev.db"
JWT_SECRET="your-jwt-secret-change-me"

# Freedom Pay
FREEDOM_PAY_MERCHANT_ID="your-merchant-id"
FREEDOM_PAY_SECRET_KEY="your-secret-key"
FREEDOM_PAY_API_BASE_URL="https://api.freedompay.kg"
FREEDOM_PAY_RESULT_URL="https://your-backend-domain.com/api/webhooks/freedom"
FREEDOM_PAY_SUCCESS_URL="https://your-frontend-domain.com/success.html"
FREEDOM_PAY_FAILURE_URL="https://your-frontend-domain.com/failure.html"
FREEDOM_PAY_TESTING_MODE="1"

# Telegram
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHANNEL_ID="your-default-channel-id"

# Telegram каналы для каждого тарифа (опционально, используются при seeding)
# Если не указаны, можно настроить напрямую в базе данных
TELEGRAM_CHANNEL_BASIC="@basic_channel_name"
TELEGRAM_CHANNEL_PRO="@pro_channel_name"
TELEGRAM_CHANNEL_MENTORSHIP="@mentorship_channel_name"

# Admin Credentials
ADMIN_USERNAME ="admin";
ADMIN_PASSWORD ="qwerty";
